{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routing_skills",
  "type": "object",
  "required": ["version", "registry_version", "generated_at", "skill_count", "skills"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "registry_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "skill_count": {"type": "integer", "minimum": 0},
    "skills": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/skill_entry"}
    }
  },
  "$defs": {
    "skill_entry": {
      "type": "object",
      "required": [
        "name",
        "description",
        "intent_class",
        "scope",
        "consumes",
        "produces",
        "tags",
        "source",
        "path",
        "routing_version"
      ],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "intent_class": {"type": "string"},
        "scope": {"type": "string"},
        "consumes": {"type": "string"},
        "produces": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "triggers": {"type": ["string", "array"]},
        "source": {"type": "string"},
        "path": {"type": "string"},
        "routing_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "trust_level": {"type": "string"},
        "quality_warnings": {"type": "array", "items": {"type": "string"}},
        "line_count": {"type": "integer", "minimum": 0},
        "resource_paths": {"type": "array", "items": {"type": "string"}},
        "content_hash": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
